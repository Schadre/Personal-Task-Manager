[Unit]
Description=Task Manager (dev) — Flask + Vite SPA
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=deploy
Group=deploy
WorkingDirectory=/srv/task-manager/dev/BE_task_manager
Environment=TASKMGR_ENV=dev
Environment=TASKMGR_DB_PATH=/srv/task-manager/dev/data/database.db
ExecStartPre=/bin/mkdir -p /srv/task-manager/dev/data
ExecStart=/srv/task-manager/dev/.venv/bin/gunicorn \
    --bind 127.0.0.1:5001 \
    --workers 2 \
    --access-logfile /var/log/task-manager/dev-access.log \
    --error-logfile /var/log/task-manager/dev-error.log \
    app:app
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/task-manager/dev /var/log/task-manager
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
