[Unit]
Description=Task Manager (prod) — Flask + Vite SPA
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=deploy
Group=deploy
WorkingDirectory=/srv/task-manager/prod/BE_task_manager
Environment=TASKMGR_ENV=prod
Environment=TASKMGR_DB_PATH=/srv/task-manager/prod/data/database.db
ExecStartPre=/bin/mkdir -p /srv/task-manager/prod/data
ExecStart=/srv/task-manager/prod/.venv/bin/gunicorn \
    --bind 127.0.0.1:5000 \
    --workers 3 \
    --access-logfile /var/log/task-manager/prod-access.log \
    --error-logfile /var/log/task-manager/prod-error.log \
    app:app
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/task-manager/prod /var/log/task-manager
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
